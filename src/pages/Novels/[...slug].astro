---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const partOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
  const entries = (await getCollection('novels')).filter((entry) => {
    const id = entry.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  });
  const ordered = entries.sort((a, b) => {
    const partDiff = partOrder.indexOf(a.data.part) - partOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });

  return ordered.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const chapterPartOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
const chapters = (await getCollection('novels'))
  .filter((chapter) => {
    const id = chapter.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  })
  .sort((a, b) => {
    const partDiff = chapterPartOrder.indexOf(a.data.part) - chapterPartOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });
const currentIndex = chapters.findIndex((chapter) => chapter.id === entry.id);
const previousChapter = chapters[currentIndex - 1];
const nextChapter = chapters[currentIndex + 1];
const musicDirectory = new URL('../../../public/music', import.meta.url);
const allowedAudioExtensions = /\.(mp3|wav|m4a|ogg|aac|flac|mid|midi|opus|webm)$/i;
let musicFiles = [];
try {
  const fs = await import('node:fs/promises');
  const items = await fs.readdir(musicDirectory, { withFileTypes: true });
  musicFiles = items
    .filter((item) => item.isFile())
    .map((item) => item.name)
    .filter((name) => allowedAudioExtensions.test(name))
    .sort();
} catch {
  musicFiles = [];
}
const { Content } = await render(entry);
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{entry.data.title} - Chandelier In the Midnight with an Idoit and a Cup · 《吊灯》</title>
    <style>
      :root {
        --paper: #f5f0ea;
        --paper-deep: #efe8df;
        --paper-soft: rgba(255, 255, 255, 0.42);
        --ink: #1b1b1b;
        --ink-soft: #5b564f;
        --line: rgba(20, 20, 20, 0.14);
        --line-strong: rgba(20, 20, 20, 0.22);
        --panel: rgba(255, 255, 255, 0.18);
        --shadow: rgba(55, 38, 22, 0.12);
        --gold: #8d7a5a;
        --glow: rgba(126, 111, 83, 0.26);
      }

      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #f6f1eb 0%, #efe8df 100%);
        color: var(--ink);
        font-family: '宋体', 'SimSun', 'Noto Serif SC', serif;
      }
      body {
        min-height: 100vh;
      }
      a { color: inherit; }
      .topbar {
        height: 64px;
        background: rgba(255, 255, 255, 0.2);
        border-bottom: 1px solid var(--line);
      }
      .layout {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 18px 60px;
        display: grid;
        grid-template-columns: 260px minmax(0, 980px);
        justify-content: center;
        gap: 28px;
      }
      .sidebar {
        position: sticky;
        top: 18px;
        align-self: start;
        background: rgba(255, 255, 255, 0.22);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 18px 14px;
        box-shadow: 0 20px 40px rgba(26, 18, 11, 0.04);
        backdrop-filter: blur(10px);
      }
      .brand-block {
        padding: 6px 6px 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }
      .brand-en {
        font-size: 0.76rem;
        line-height: 1.7;
        color: var(--muted);
      }
      .brand-cn {
        margin-top: 6px;
        font-size: 1.5rem;
        font-weight: 700;
      }
      .music-panel {
        margin-bottom: 18px;
        padding: 12px 10px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.16);
      }
      .music-header {
        margin: 0 0 10px;
        font-size: 0.8rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .music-select {
        width: 100%;
        margin-bottom: 10px;
        padding: 9px 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.4);
        color: var(--ink);
        font: inherit;
      }
      .music-player {
        width: 100%;
        max-width: 100%;
        margin-bottom: 10px;
      }
      .upload-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: 8px 10px;
        border: 1px dashed var(--line);
        border-radius: 8px;
        background: rgba(0, 0, 0, 0.02);
        cursor: pointer;
        font-size: 0.86rem;
        color: var(--muted);
      }
      .upload-label input {
        display: none;
      }
      .sidebar h2 {
        margin: 0 0 14px;
        font-size: 0.96rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .part-group {
        margin-bottom: 18px;
      }
      .part-name {
        margin-bottom: 8px;
        font-weight: 700;
        font-size: 1rem;
      }
      .chapter-list {
        display: grid;
        gap: 6px;
      }
      .chapter-link {
        display: block;
        padding: 8px 10px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--ink);
        border: 1px solid transparent;
        transition: all 0.2s ease;
      }
      .chapter-link:hover,
      .chapter-link.active {
        background: rgba(0, 0, 0, 0.03);
        border-color: var(--line);
      }
      .article-panel {
        width: 100%;
        justify-self: start;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 32px 32px 40px;
        min-height: 70vh;
        box-shadow: 0 12px 30px rgba(45, 32, 20, 0.025);
      }
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin-bottom: 12px;
      }
      h1 {
        margin: 0 0 18px;
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 700;
        line-height: 1.4;
        text-align: right;
      }
      article {
        line-height: 2.1;
        font-size: 1.06rem;
        text-align: justify;
        text-indent: 2em;
        color: var(--ink);
      }
      article p {
        margin: 0 0 1.3em;
      }
      .nav-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
      }
      .nav-link {
        flex: 1;
        min-width: 180px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.08);
        text-decoration: none;
        color: var(--ink);
      }
      .nav-link.next {
        background: rgba(0, 0, 0, 0.02);
      }
      .home-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 4px 0 16px;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: var(--ink);
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
        }

        .article-panel {
          padding: 24px 20px 30px;
        }
      }

      @media (max-width: 560px) {
        .layout {
          padding-left: 12px;
          padding-right: 12px;
          gap: 16px;
        }

        .sidebar {
          padding: 14px 12px;
        }

        .brand-cn {
          font-size: 1.4rem;
        }

        .music-panel {
          padding-left: 10px;
          padding-right: 10px;
        }

        .article-panel {
          padding: 20px 16px 28px;
        }

        h1 {
          font-size: clamp(1.8rem, 9vw, 2.5rem);
        }

        article {
          font-size: 1rem;
          line-height: 1.9;
        }

        .nav-row {
          display: grid;
          grid-template-columns: 1fr;
        }

        .nav-link {
          min-width: unset;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar" aria-label="顶部导航"></header>

    <div class="layout">
      <aside class="sidebar">
        <div class="brand-block">
          <div class="brand-en">Chandelier In the Midnight with an Idoit and a Cup</div>
          <div class="brand-cn">《吊灯》</div>
        </div>

        <a class="home-link" href="/" aria-label="返回主页">← 回到主页</a>

        <div class="music-panel">
          <div class="music-header">音乐播放器</div>
          <select class="music-select" id="musicSelect" aria-label="选择播放音乐">
            <option value="">请选择音乐</option>
            {musicFiles.map((fileName) => (
              <option value={`/music/${encodeURIComponent(fileName)}`}>{fileName}</option>
            ))}
          </select>
          <audio class="music-player" id="musicPlayer" controls preload="none"></audio>
          <label class="upload-label">
            <input id="musicUpload" type="file" accept=".mp3,.wav,.m4a,.ogg,.aac,.flac,.mid,.midi,.opus,.webm,audio/*" />
            <span>上传本地音乐</span>
          </label>
        </div>

        <h2>章节列表</h2>
        {chapterPartOrder.map((part) => {
          const partChapters = chapters.filter((chapter) => chapter.data.part === part);
          if (partChapters.length === 0) return null;
          return (
            <div class="part-group">
              <div class="part-name">{part}</div>
              <div class="chapter-list">
                {partChapters.map((chapter) => (
                  <a
                    class={`chapter-link ${chapter.id === entry.id ? 'active' : ''}`}
                    href={`/Novels/${chapter.id.replace(/\.md$/, '')}`}
                  >
                    {chapter.data.title}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </aside>

      <main class="article-panel">
        <div class="meta">{entry.data.part} · {entry.data.title}</div>
        <h1>{entry.data.title}</h1>
        <article>
          <Content />
        </article>

        <div class="nav-row">
          {previousChapter ? (
            <a class="nav-link" href={`/Novels/${previousChapter.id.replace(/\.md$/, '')}`}>
              ← 上一章
            </a>
          ) : <span class="nav-link">已是第一章</span>}
          {nextChapter ? (
            <a class="nav-link next" href={`/Novels/${nextChapter.id.replace(/\.md$/, '')}`}>
              下一章 →
            </a>
          ) : <span class="nav-link">已是末章</span>}
        </div>

      </main>
    </div>

    <script is:inline>
      const musicSelect = document.getElementById('musicSelect');
      const musicPlayer = document.getElementById('musicPlayer');
      const musicUpload = document.getElementById('musicUpload');

      if (musicSelect && musicPlayer) {
        musicSelect.addEventListener('change', () => {
          const selected = musicSelect.value;
          if (!selected) {
            musicPlayer.removeAttribute('src');
            musicPlayer.load();
            return;
          }

          musicPlayer.src = selected;
          musicPlayer.load();
          musicPlayer.play().catch(() => {});
        });
      }

      if (musicUpload && musicPlayer) {
        musicUpload.addEventListener('change', (event) => {
          const file = event.target.files && event.target.files[0];
          if (!file) return;

          const objectUrl = URL.createObjectURL(file);
          const option = new Option(`本地：${file.name}`, objectUrl, false, true);
          musicSelect?.appendChild(option);
          musicPlayer.src = objectUrl;
          musicPlayer.load();
          musicPlayer.play().catch(() => {});
        });
      }
    </script>
  </body>
</html>
