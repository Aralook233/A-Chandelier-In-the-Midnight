---
import { getCollection, render } from 'astro:content';
import RadioPlayer from '../../components/RadioPlayer.astro';
import '../../styles/story-font.css';
import '../../styles/homepage-motion.css';
import '../../styles/story-typography.css';

export async function getStaticPaths() {
  const partOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
  const entries = (await getCollection('novels')).filter((entry) => {
    const id = entry.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  });
  const ordered = entries.sort((a, b) => {
    const partDiff = partOrder.indexOf(a.data.part) - partOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });

  return ordered.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const chapterPartOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
const chapters = (await getCollection('novels'))
  .filter((chapter) => {
    const id = chapter.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  })
  .sort((a, b) => {
    const partDiff = chapterPartOrder.indexOf(a.data.part) - chapterPartOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });
const currentIndex = chapters.findIndex((chapter) => chapter.id === entry.id);
const previousChapter = chapters[currentIndex - 1];
const nextChapter = chapters[currentIndex + 1];
const musicDirectory = new URL('../../../public/music', import.meta.url);
const allowedAudioExtensions = /\.(mp3|wav|m4a|ogg|aac|flac|mid|midi|opus|webm)$/i;
let musicFiles = [];
try {
  const fs = await import('node:fs/promises');
  const items = await fs.readdir(musicDirectory, { withFileTypes: true });
  musicFiles = items
    .filter((item) => item.isFile())
    .map((item) => item.name)
    .filter((name) => allowedAudioExtensions.test(name))
    .sort();
} catch {
  musicFiles = [];
}
const { Content } = await render(entry);
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{entry.data.title} - Chandelier In the Midnight with an Idoit and a Cup · 《吊灯》</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f5f0ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17140f" />
    <link rel="alternate" type="application/rss+xml" title="《吊灯》更新订阅" href="/rss.xml" />
    <style>
      :root {
        color-scheme: light;
        --paper: #f5f0ea;
        --paper-deep: #efe8df;
        --paper-soft: rgba(255, 255, 255, 0.42);
        --ink: #1b1b1b;
        --ink-soft: #5b564f;
        --muted: var(--ink-soft);
        --line: rgba(20, 20, 20, 0.14);
        --line-strong: rgba(20, 20, 20, 0.22);
        --panel: rgba(255, 255, 255, 0.18);
        --shadow: rgba(55, 38, 22, 0.12);
        --gold: #8d7a5a;
        --glow: rgba(126, 111, 83, 0.26);

        --tint-rgb: 255, 255, 255;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #f6f1eb 0%, #efe8df 100%);
        --input-bg: rgba(255, 255, 255, 0.4);
        --chip-bg: rgba(0, 0, 0, 0.02);
        --active-bg: rgba(0, 0, 0, 0.03);
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
        --paper: #17140f;
        --paper-deep: #12100c;
        --paper-soft: rgba(255, 255, 255, 0.06);
        --ink: #ece4d6;
        --ink-soft: #a89c8a;
        --line: rgba(232, 220, 200, 0.16);
        --line-strong: rgba(232, 220, 200, 0.26);
        --panel: rgba(255, 255, 255, 0.05);
        --shadow: rgba(0, 0, 0, 0.45);
        --gold: #c8ab72;
        --glow: rgba(200, 171, 114, 0.22);

        --tint-rgb: 214, 200, 178;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #17140f 0%, #100e0a 100%);
        --input-bg: rgba(255, 255, 255, 0.08);
        --chip-bg: rgba(255, 255, 255, 0.05);
        --active-bg: rgba(255, 255, 255, 0.12);
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --paper: #17140f;
          --paper-deep: #12100c;
          --paper-soft: rgba(255, 255, 255, 0.06);
          --ink: #ece4d6;
          --ink-soft: #a89c8a;
          --line: rgba(232, 220, 200, 0.16);
          --line-strong: rgba(232, 220, 200, 0.26);
          --panel: rgba(255, 255, 255, 0.05);
          --shadow: rgba(0, 0, 0, 0.45);
          --gold: #c8ab72;
          --glow: rgba(200, 171, 114, 0.22);

          --tint-rgb: 214, 200, 178;
          --page-bg:
            radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
            linear-gradient(180deg, #17140f 0%, #100e0a 100%);
          --input-bg: rgba(255, 255, 255, 0.08);
          --chip-bg: rgba(255, 255, 255, 0.05);
          --active-bg: rgba(255, 255, 255, 0.12);
        }
      }

      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        min-height: 100vh;
        background: var(--page-bg);
        color: var(--ink);
        font-family: var(--font-story);
      }
      body {
        min-height: 100vh;
      }
      a { color: inherit; }
      .topbar {
        height: 64px;
        background: rgba(var(--tint-rgb), 0.2);
        border-bottom: 1px solid var(--line);
      }
      .topbar-inner {
        max-width: 1280px;
        height: 100%;
        margin: 0 auto;
        padding: 0 18px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }
      .theme-toggle {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.24);
        color: var(--ink);
        padding: 8px 14px;
        font: inherit;
        cursor: pointer;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      /* 平涂 + 发丝线 + 3px 实色偏移，和 homepage-motion.css 同一套语言 */
      .reading-progress {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 10px;
        z-index: 50;
        background: var(--chip-bg);
        border-bottom: 1px solid var(--line-strong);
        pointer-events: none;
      }
      .reading-progress-fill {
        display: block;
        height: 100%;
        width: 100%;
        transform: scaleX(0);
        transform-origin: 0 50%;
        background: var(--motion-accent);
        transition: transform 0.12s linear;
      }
      .reading-progress-badge {
        position: fixed;
        top: 16px;
        left: 50%;
        z-index: 51;
        padding: 4px 12px 5px;
        border: 1px solid var(--line-strong);
        background: var(--paper-deep);
        color: var(--ink-soft);
        box-shadow: 3px 3px 0 var(--line-strong);
        font-size: 0.74rem;
        letter-spacing: 0.16em;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(-50%) translateY(-8px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .reading-progress-badge.is-visible {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }
      /* 完成态用红色描边和偏移块标记，文字仍走 --ink：小字号上金色和深红都不过 AA */
      .reading-progress-badge.is-complete {
        color: var(--ink);
        border-color: var(--motion-accent);
        box-shadow: 3px 3px 0 var(--motion-accent);
      }
      @media (prefers-reduced-motion: reduce) {
        .reading-progress-fill {
          transition: none;
        }

        .reading-progress-badge {
          transition: none;
        }
      }
      .layout {
        max-width: 1280px;
        margin: 0 auto;
        padding: 24px 18px 60px;
        display: grid;
        grid-template-columns: 260px minmax(0, 980px);
        justify-content: center;
        gap: 28px;
      }
      .sidebar {
        position: sticky;
        top: 18px;
        align-self: start;
        background: rgba(var(--tint-rgb), 0.22);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 18px 14px;
        box-shadow: 0 20px 40px rgba(26, 18, 11, 0.04);
        backdrop-filter: blur(10px);
      }
      .brand-block {
        padding: 6px 6px 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }
      .brand-en {
        font-size: 0.76rem;
        line-height: 1.7;
        color: var(--muted);
      }
      .brand-cn {
        margin-top: 6px;
        font-size: 1.5rem;
        font-weight: 700;
      }
      .sidebar h2 {
        margin: 0 0 14px;
        font-size: 0.96rem;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .part-group {
        margin-bottom: 18px;
      }
      .part-name {
        margin-bottom: 8px;
        font-weight: 700;
        font-size: 1rem;
      }
      .chapter-list {
        display: grid;
        gap: 6px;
      }
      .chapter-link {
        display: block;
        padding: 8px 10px;
        border-radius: 8px;
        text-decoration: none;
        color: var(--ink);
        border: 1px solid transparent;
        transition: all 0.2s ease;
      }
      .chapter-link:hover,
      .chapter-link.active {
        background: var(--active-bg);
        border-color: var(--line);
      }
      .article-panel {
        width: 100%;
        justify-self: start;
        background: rgba(var(--tint-rgb), 0.12);
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 32px 32px 40px;
        min-height: 70vh;
        box-shadow: 0 12px 30px rgba(45, 32, 20, 0.025);
      }
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
        margin-bottom: 12px;
      }
      h1 {
        margin: 0 0 18px;
        font-size: clamp(2rem, 3vw, 2.8rem);
        font-weight: 700;
        line-height: 1.4;
        text-align: right;
      }
      article {
        color: var(--ink);
        font-size: 1.06rem;
        line-height: 2.15;
      }
      /* Markdown 渲染出的标签不带本页的 scope 属性，必须用 :global 才能命中。 */
      article :global(p) {
        margin: 0 0 1.35em;
        text-align: justify;
        text-indent: 2em;
        line-break: strict;
        overflow-wrap: break-word;
      }
      article :global(p:last-child) {
        margin-bottom: 0;
      }
      /* 开篇首句自成一段后，与正文之间留一次完整的呼吸。 */
      article > :global(p:first-child) {
        margin-bottom: 1.9em;
      }
      .nav-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
      }
      .nav-link {
        flex: 1;
        min-width: 180px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 16px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: rgba(var(--tint-rgb), 0.08);
        text-decoration: none;
        color: var(--ink);
      }
      .nav-link.next {
        background: var(--chip-bg);
      }
      .home-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 4px 0 16px;
        padding: 8px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.08);
        color: var(--ink);
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      @media (max-width: 1100px) {
        .layout {
          grid-template-columns: 232px minmax(0, 1fr);
          gap: 22px;
        }

        .article-panel {
          padding: 28px 26px 34px;
        }
      }

      @media (max-width: 1024px) {
        .theme-toggle,
        .home-link,
        .chapter-link,
        .nav-link {
          min-height: 44px;
        }
      }

      @media (max-width: 900px) {
        .layout {
          grid-template-columns: 1fr;
          padding: 20px 16px 44px;
          gap: 18px;
        }

        .sidebar {
          position: static;
          order: 2;
          margin-top: 6px;
        }

        .chapter-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .chapter-link {
          padding: 10px 12px;
          overflow-wrap: anywhere;
        }

        .article-panel {
          order: 1;
          padding: 24px 20px 30px;
          min-height: 0;
        }
      }

      @media (max-width: 560px) {
        .layout {
          padding-left: max(12px, env(safe-area-inset-left));
          padding-right: max(12px, env(safe-area-inset-right));
          padding-bottom: max(40px, env(safe-area-inset-bottom));
          gap: 16px;
        }

        .topbar {
          height: 58px;
        }

        .topbar-inner {
          padding: 0 12px;
        }

        .sidebar {
          padding: 14px 12px;
        }

        .chapter-list {
          grid-template-columns: 1fr;
        }

        .brand-cn {
          font-size: 1.4rem;
        }

        .music-panel {
          padding-left: 10px;
          padding-right: 10px;
        }

        .article-panel {
          padding: 20px 16px 28px;
          border-radius: 16px;
        }

        h1 {
          font-size: clamp(1.8rem, 9vw, 2.5rem);
        }

        article {
          font-size: 1.02rem;
          line-height: 1.95;
        }

        article :global(p) {
          margin-bottom: 1.2em;
          text-indent: 1.5em;
        }

        .nav-row {
          display: grid;
          grid-template-columns: 1fr;
        }

        .nav-link {
          min-width: unset;
          min-height: 44px;
        }
      }
    </style>
  </head>
  <body>
    <div class="reading-progress" id="readingProgress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <span class="reading-progress-fill" id="readingProgressFill"></span>
    </div>
    <span class="reading-progress-badge" id="readingProgressBadge" aria-hidden="true">已读 0%</span>

    <header class="topbar" aria-label="顶部导航">
      <div class="topbar-inner">
        <button class="theme-toggle" id="themeToggle" type="button" data-theme-toggle aria-pressed="false">深色</button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <div class="brand-block">
          <div class="brand-en">Chandelier In the Midnight with an Idoit and a Cup</div>
          <div class="brand-cn">《吊灯》</div>
        </div>

        <a class="home-link" href="/" aria-label="返回主页">← 回到主页</a>

        <RadioPlayer musicFiles={musicFiles} />

        <h2>章节列表</h2>
        {chapterPartOrder.map((part) => {
          const partChapters = chapters.filter((chapter) => chapter.data.part === part);
          if (partChapters.length === 0) return null;
          return (
            <div class="part-group">
              <div class="part-name">{part}</div>
              <div class="chapter-list">
                {partChapters.map((chapter) => (
                  <a
                    class={`chapter-link ${chapter.id === entry.id ? 'active' : ''}`}
                    href={`/Novels/${chapter.id.replace(/\.md$/, '')}`}
                  >
                    {chapter.data.title}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </aside>

      <main class="article-panel">
        <div class="meta">{entry.data.part} · {entry.data.title}</div>
        <h1>{entry.data.title}</h1>
        <article>
          <Content />
        </article>

        <div class="nav-row">
          {previousChapter ? (
            <a class="nav-link" href={`/Novels/${previousChapter.id.replace(/\.md$/, '')}`}>
              ← 上一章
            </a>
          ) : <span class="nav-link">已是第一章</span>}
          {nextChapter ? (
            <a class="nav-link next" href={`/Novels/${nextChapter.id.replace(/\.md$/, '')}`}>
              下一章 →
            </a>
          ) : <span class="nav-link">已是末章</span>}
        </div>

      </main>
    </div>

    <script>
      import { initTheme, toggleTheme } from '../../utils/theme';

      initTheme();
      document.getElementById('themeToggle')?.addEventListener('click', () => toggleTheme());

      const progressBar = document.getElementById('readingProgress');
      const progressFill = document.getElementById('readingProgressFill');
      const progressBadge = document.getElementById('readingProgressBadge');

      if (progressBar && progressFill) {
        let ticking = false;

        const updateProgress = () => {
          ticking = false;
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(Math.max((window.scrollY || doc.scrollTop || 0) / scrollable, 0), 1) : 0;
          const percent = Math.round(ratio * 100);
          const done = percent >= 99;

          progressFill.style.transform = `scaleX(${ratio.toFixed(4)})`;
          progressBar.setAttribute('aria-valuenow', String(percent));
          progressBar.setAttribute('aria-valuetext', done ? '已读完全章' : `已读 ${percent}%`);

          if (progressBadge) {
            progressBadge.textContent = done ? '本章读完' : `已读 ${percent}%`;
            progressBadge.classList.toggle('is-visible', ratio > 0.01);
            progressBadge.classList.toggle('is-complete', done);
          }
        };

        const requestUpdate = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updateProgress);
        };

        window.addEventListener('scroll', requestUpdate, { passive: true });
        window.addEventListener('resize', requestUpdate);
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) requestUpdate();
        });
        requestAnimationFrame(updateProgress);
      }
    </script>
  </body>
</html>
