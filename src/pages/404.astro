---
import { getCollection } from 'astro:content';
import '../styles/story-font.css';
import '../styles/homepage-motion.css';

const partOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
const entries = (await getCollection('novels'))
  .filter((entry) => {
    const id = entry.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  })
  .sort((a, b) => {
    const partDiff = partOrder.indexOf(a.data.part) - partOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });
const firstChapter = entries[0] ?? null;
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>你怎么到这里来了？ - Chandelier In the Midnight with an Idoit and a Cup · 《吊灯》</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f5f0ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17140f" />
    <link rel="alternate" type="application/rss+xml" title="《吊灯》更新订阅" href="/rss.xml" />
    <style>
      :root {
        color-scheme: light;
        --paper: #f5f0ea;
        --ink: #1b1b1b;
        --ink-soft: #5b564f;
        --line: rgba(20, 20, 20, 0.14);
        --line-strong: rgba(20, 20, 20, 0.22);
        --shadow: rgba(55, 38, 22, 0.12);
        --gold: #8d7a5a;

        --tint-rgb: 255, 255, 255;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #f6f1eb 0%, #efe8df 100%);
        --stage-bg:
          radial-gradient(circle at 52% 42%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.2) 22%, rgba(245, 238, 229, 0.96) 60%, rgba(237, 228, 216, 0.92));
        --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 24px 60px rgba(40, 24, 10, 0.08);
        --card-bg: rgba(248, 244, 239, 0.96);
        --chip-bg: rgba(0, 0, 0, 0.02);
        --btn-bg: rgba(22, 18, 14, 0.05);

        --canvas-shell: rgba(112, 170, 220, 0.28);
        --canvas-shell-soft: rgba(112, 170, 220, 0.18);
        --canvas-core: rgba(33, 30, 26, 0.82);
        --canvas-label: rgba(40, 34, 28, 0.9);
        --canvas-edge-rgb: 38, 30, 22;
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
        --paper: #17140f;
        --ink: #ece4d6;
        --ink-soft: #a89c8a;
        --line: rgba(232, 220, 200, 0.16);
        --line-strong: rgba(232, 220, 200, 0.26);
        --shadow: rgba(0, 0, 0, 0.45);
        --gold: #c8ab72;

        --tint-rgb: 214, 200, 178;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #17140f 0%, #100e0a 100%);
        --stage-bg:
          radial-gradient(circle at 52% 42%, rgba(70, 62, 50, 0.95), rgba(40, 35, 28, 0.55) 22%, rgba(26, 23, 18, 0.96) 60%, rgba(16, 14, 11, 0.96));
        --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 24px 60px rgba(0, 0, 0, 0.55);
        --card-bg: rgba(26, 22, 18, 0.97);
        --chip-bg: rgba(255, 255, 255, 0.05);
        --btn-bg: rgba(255, 255, 255, 0.09);

        --canvas-shell: rgba(150, 200, 240, 0.24);
        --canvas-shell-soft: rgba(150, 200, 240, 0.14);
        --canvas-core: rgba(232, 220, 196, 0.85);
        --canvas-label: rgba(236, 226, 206, 0.92);
        --canvas-edge-rgb: 226, 214, 190;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --paper: #17140f;
          --ink: #ece4d6;
          --ink-soft: #a89c8a;
          --line: rgba(232, 220, 200, 0.16);
          --line-strong: rgba(232, 220, 200, 0.26);
          --shadow: rgba(0, 0, 0, 0.45);
          --gold: #c8ab72;

          --tint-rgb: 214, 200, 178;
          --page-bg:
            radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
            linear-gradient(180deg, #17140f 0%, #100e0a 100%);
          --stage-bg:
            radial-gradient(circle at 52% 42%, rgba(70, 62, 50, 0.95), rgba(40, 35, 28, 0.55) 22%, rgba(26, 23, 18, 0.96) 60%, rgba(16, 14, 11, 0.96));
          --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 24px 60px rgba(0, 0, 0, 0.55);
          --card-bg: rgba(26, 22, 18, 0.97);
          --chip-bg: rgba(255, 255, 255, 0.05);
          --btn-bg: rgba(255, 255, 255, 0.09);

          --canvas-shell: rgba(150, 200, 240, 0.24);
          --canvas-shell-soft: rgba(150, 200, 240, 0.14);
          --canvas-core: rgba(232, 220, 196, 0.85);
          --canvas-label: rgba(236, 226, 206, 0.92);
          --canvas-edge-rgb: 226, 214, 190;
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        min-height: 100%;
        background: var(--page-bg);
        color: var(--ink);
        font-family: var(--font-story);
      }

      body {
        min-height: 100vh;
        min-height: 100dvh;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .topbar {
        height: 62px;
        border-bottom: 1px solid var(--line);
        background: rgba(var(--tint-rgb), 0.15);
      }

      .topbar-inner {
        max-width: 1440px;
        height: 100%;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
      }

      .theme-toggle,
      .topbar-home {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.2);
        color: var(--ink);
        padding: 8px 14px;
        font: inherit;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
      }

      .lost-shell {
        max-width: 1440px;
        min-height: calc(100vh - 62px);
        min-height: calc(100dvh - 62px);
        margin: 0 auto;
        padding: 30px 20px 46px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 620px);
        align-items: center;
        justify-items: center;
        gap: 34px;
      }

      .lost-stage {
        position: relative;
        width: min(100%, 560px);
        aspect-ratio: 1 / 1;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--stage-bg);
        overflow: hidden;
        isolation: isolate;
        box-shadow: var(--stage-shadow);
      }

      .stage-glow {
        position: absolute;
        inset: 12% 18%;
        border-radius: 50%;
        border: 1px solid var(--line);
        z-index: 0;
        pointer-events: none;
        box-shadow: 0 0 0 26px var(--chip-bg), inset 0 0 0 10px var(--chip-bg);
      }

      .tesseract-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 1;
        background: transparent;
      }

      .lost-panel {
        width: 100%;
        padding: 26px 28px 24px;
        border: 1px solid var(--line);
        border-radius: 22px;
        background: rgba(var(--tint-rgb), 0.2);
        box-shadow: 0 12px 30px var(--shadow);
      }

      .eyebrow {
        color: var(--ink-soft);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-size: 0.72rem;
        font-weight: 700;
      }

      h1 {
        margin: 12px 0 14px;
        font-size: clamp(2rem, 4vw, 3.4rem);
        letter-spacing: 0.06em;
        line-height: 1.16;
      }

      .lost-text {
        margin: 0 0 22px;
        max-width: 52ch;
        color: var(--ink-soft);
        font-size: 1.02rem;
        line-height: 1.9;
      }

      .lost-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .lost-actions a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        background: var(--btn-bg);
        font-size: 0.82rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .lost-actions a.primary {
        background: var(--card-bg);
      }

      @media (max-width: 1040px) {
        .lost-shell {
          grid-template-columns: minmax(0, 1fr);
          justify-items: center;
          gap: 26px;
          padding-top: 22px;
        }

        .lost-stage {
          width: min(100%, 460px);
        }

        .lost-panel {
          max-width: 620px;
        }
      }

      @media (max-height: 820px) and (min-width: 641px) {
        .lost-shell {
          gap: 22px;
          padding-top: 12px;
          padding-bottom: 20px;
        }

        .lost-stage {
          width: min(100%, 360px);
        }

        h1 {
          font-size: clamp(1.9rem, 3.4vw, 2.6rem);
        }
      }

      @media (max-width: 640px) {
        .topbar-inner,
        .lost-shell {
          padding-left: 14px;
          padding-right: 14px;
        }

        .lost-shell {
          gap: 20px;
        }

        .lost-stage {
          width: min(100%, 340px);
        }

        .stage-glow {
          inset: 10% 14%;
        }

        .lost-panel {
          padding: 20px 18px 18px;
          border-radius: 18px;
        }

        h1 {
          font-size: clamp(1.7rem, 8.4vw, 2.4rem);
          letter-spacing: 0.04em;
        }

        .lost-text {
          font-size: 0.96rem;
          margin-bottom: 18px;
        }

        .lost-actions a {
          flex: 1 1 46%;
          padding: 12px 14px;
        }
      }

      @media (max-width: 420px) {
        .topbar {
          height: 56px;
        }

        .lost-shell {
          min-height: calc(100vh - 56px);
          min-height: calc(100dvh - 56px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .tesseract-canvas {
          opacity: 0.7;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar" aria-label="顶部导航">
      <div class="topbar-inner">
        <button class="theme-toggle" id="themeToggle" type="button" data-theme-toggle aria-pressed="false">深色</button>
        <a class="topbar-home" href="/">主页</a>
      </div>
    </header>

    <div class="lost-shell">
      <section class="lost-stage" aria-label="404 动画展示区">
        <div class="stage-glow"></div>
        <canvas class="tesseract-canvas" id="tesseractCanvas" aria-label="超立方体线框动画"></canvas>
      </section>

      <section class="lost-panel">
        <div class="eyebrow">404 · Lost in the midnight</div>
        <h1>你怎么到这里来了？</h1>
        <p class="lost-text">
          这里的灯火没有照向任何一页正文。也许是链接断了，也许是夜色把你带错了方向。<br>
          回到主页，吊灯还亮着。
        </p>
        <div class="lost-actions">
          <a class="primary" href="/">回到主页</a>
          {firstChapter ? (
            <a href={`/Novels/${firstChapter.id.replace(/\.md$/, '')}`}>从第一章开始</a>
          ) : (
            <a href="/">重新点亮灯火</a>
          )}
        </div>
      </section>
    </div>

    <script>
      import { initTheme, toggleTheme } from '../utils/theme';
      import { mountTesseract } from '../utils/tesseract';

      initTheme();
      document.getElementById('themeToggle')?.addEventListener('click', () => toggleTheme());
      mountTesseract(document.getElementById('tesseractCanvas'));
    </script>
  </body>
</html>
