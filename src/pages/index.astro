---
import { getCollection } from 'astro:content';
import RadioPlayer from '../components/RadioPlayer.astro';
import '../styles/story-font.css';
import '../styles/homepage-motion.css';
import '../styles/moderation.css';

const partOrder = ['第一卷', '第二卷', '第三卷', '第四卷', '第五卷', '第六卷'];
const rawEntries = await getCollection('novels');
const entries = rawEntries
  .filter((entry) => {
    const id = entry.id.replace(/\.md$/, '');
    return id.includes('/') && /第\d+章$/.test(id);
  })
  .sort((a, b) => {
    const partDiff = partOrder.indexOf(a.data.part) - partOrder.indexOf(b.data.part);
    if (partDiff !== 0) return partDiff;
    return a.data.chapter - b.data.chapter;
  });

const chaptersByPart = partOrder.map((part) => ({
  part,
  chapters: entries.filter((entry) => entry.data.part === part),
}));
const featuredChapter = entries[0] ?? null;
const musicDirectory = new URL('../../public/music', import.meta.url);
const allowedAudioExtensions = /\.(mp3|wav|m4a|ogg|aac|flac|mid|midi|opus|webm)$/i;
let musicFiles = [];
try {
  const fs = await import('node:fs/promises');
  const items = await fs.readdir(musicDirectory, { withFileTypes: true });
  musicFiles = items
    .filter((item) => item.isFile())
    .map((item) => item.name)
    .filter((name) => allowedAudioExtensions.test(name))
    .sort();
} catch {
  musicFiles = [];
}
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Chandelier In the Midnight with an Idoit and a Cup — 《吊灯》</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f5f0ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17140f" />
    <link rel="alternate" type="application/rss+xml" title="《吊灯》更新订阅" href="/rss.xml" />
    <style>
      :root {
        color-scheme: light;
        --paper: #f5f0ea;
        --paper-deep: #efe8df;
        --paper-soft: rgba(255, 255, 255, 0.42);
        --ink: #1b1b1b;
        --ink-soft: #5b564f;
        --line: rgba(20, 20, 20, 0.14);
        --line-strong: rgba(20, 20, 20, 0.22);
        --panel: rgba(255, 255, 255, 0.18);
        --shadow: rgba(55, 38, 22, 0.12);
        --gold: #8d7a5a;
        --glow: rgba(126, 111, 83, 0.26);

        --tint-rgb: 255, 255, 255;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #f6f1eb 0%, #efe8df 100%);
        --stage-bg:
          radial-gradient(circle at 52% 42%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.2) 22%, rgba(245, 238, 229, 0.96) 60%, rgba(237, 228, 216, 0.92));
        --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 24px 60px rgba(40, 24, 10, 0.08);
        --input-bg: rgba(255, 255, 255, 0.5);
        --field-bg: rgba(255, 255, 255, 0.42);
        --story-bg: rgba(255, 255, 255, 0.36);
        --card-bg: rgba(248, 244, 239, 0.96);
        --chip-bg: rgba(0, 0, 0, 0.02);
        --btn-bg: rgba(22, 18, 14, 0.05);
        --active-bg: rgba(18, 18, 18, 0.05);
        --scrim: rgba(18, 14, 10, 0.32);

        --canvas-shell: rgba(112, 170, 220, 0.28);
        --canvas-shell-soft: rgba(112, 170, 220, 0.18);
        --canvas-core: rgba(33, 30, 26, 0.82);
        --canvas-label: rgba(40, 34, 28, 0.9);
        --canvas-edge-rgb: 38, 30, 22;
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
        --paper: #17140f;
        --paper-deep: #12100c;
        --paper-soft: rgba(255, 255, 255, 0.06);
        --ink: #ece4d6;
        --ink-soft: #a89c8a;
        --line: rgba(232, 220, 200, 0.16);
        --line-strong: rgba(232, 220, 200, 0.26);
        --panel: rgba(255, 255, 255, 0.05);
        --shadow: rgba(0, 0, 0, 0.45);
        --gold: #c8ab72;
        --glow: rgba(200, 171, 114, 0.22);

        --tint-rgb: 214, 200, 178;
        --page-bg:
          radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
          linear-gradient(180deg, #17140f 0%, #100e0a 100%);
        --stage-bg:
          radial-gradient(circle at 52% 42%, rgba(70, 62, 50, 0.95), rgba(40, 35, 28, 0.55) 22%, rgba(26, 23, 18, 0.96) 60%, rgba(16, 14, 11, 0.96));
        --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 24px 60px rgba(0, 0, 0, 0.55);
        --input-bg: rgba(255, 255, 255, 0.08);
        --field-bg: rgba(255, 255, 255, 0.07);
        --story-bg: rgba(20, 17, 13, 0.62);
        --card-bg: rgba(26, 22, 18, 0.97);
        --chip-bg: rgba(255, 255, 255, 0.05);
        --btn-bg: rgba(255, 255, 255, 0.09);
        --active-bg: rgba(255, 255, 255, 0.12);
        --scrim: rgba(0, 0, 0, 0.62);

        --canvas-shell: rgba(150, 200, 240, 0.24);
        --canvas-shell-soft: rgba(150, 200, 240, 0.14);
        --canvas-core: rgba(232, 220, 196, 0.85);
        --canvas-label: rgba(236, 226, 206, 0.92);
        --canvas-edge-rgb: 226, 214, 190;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --paper: #17140f;
          --paper-deep: #12100c;
          --paper-soft: rgba(255, 255, 255, 0.06);
          --ink: #ece4d6;
          --ink-soft: #a89c8a;
          --line: rgba(232, 220, 200, 0.16);
          --line-strong: rgba(232, 220, 200, 0.26);
          --panel: rgba(255, 255, 255, 0.05);
          --shadow: rgba(0, 0, 0, 0.45);
          --gold: #c8ab72;
          --glow: rgba(200, 171, 114, 0.22);

          --tint-rgb: 214, 200, 178;
          --page-bg:
            radial-gradient(circle at top, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 32%),
            linear-gradient(180deg, #17140f 0%, #100e0a 100%);
          --stage-bg:
            radial-gradient(circle at 52% 42%, rgba(70, 62, 50, 0.95), rgba(40, 35, 28, 0.55) 22%, rgba(26, 23, 18, 0.96) 60%, rgba(16, 14, 11, 0.96));
          --stage-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 24px 60px rgba(0, 0, 0, 0.55);
          --input-bg: rgba(255, 255, 255, 0.08);
          --field-bg: rgba(255, 255, 255, 0.07);
          --story-bg: rgba(20, 17, 13, 0.62);
          --card-bg: rgba(26, 22, 18, 0.97);
          --chip-bg: rgba(255, 255, 255, 0.05);
          --btn-bg: rgba(255, 255, 255, 0.09);
          --active-bg: rgba(255, 255, 255, 0.12);
          --scrim: rgba(0, 0, 0, 0.62);

          --canvas-shell: rgba(150, 200, 240, 0.24);
          --canvas-shell-soft: rgba(150, 200, 240, 0.14);
          --canvas-core: rgba(232, 220, 196, 0.85);
          --canvas-label: rgba(236, 226, 206, 0.92);
          --canvas-edge-rgb: 226, 214, 190;
        }
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100vh;
        background: var(--page-bg);
        color: var(--ink);
        font-family: var(--font-story);
      }

      body {
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .topbar {
        height: 62px;
        border-bottom: 1px solid var(--line);
        background: rgba(var(--tint-rgb), 0.15);
      }

      .topbar-inner {
        max-width: 1440px;
        height: 100%;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
      }

      .auth-button,
      .theme-toggle {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.2);
        color: var(--ink);
        padding: 8px 14px;
        font: inherit;
        cursor: pointer;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .auth-button + .auth-button,
      .theme-toggle + .auth-button {
        margin-left: 10px;
      }

      .auth-form label.field-hidden {
        display: none;
      }

      .auth-remember {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .auth-remember input {
        width: 16px;
        height: 16px;
        accent-color: var(--ink);
      }

      .account-chip {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.2);
        color: var(--ink);
        padding: 8px 14px;
        font: inherit;
        letter-spacing: 0.08em;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .modal-submit:disabled {
        opacity: 0.6;
        cursor: progress;
      }

      .app-shell {
        max-width: 1440px;
        margin: 0 auto;
        padding: 26px 20px 60px;
        display: grid;
        grid-template-columns: minmax(260px, 320px) minmax(0, 980px);
        justify-content: center;
        gap: 28px;
      }

      .sidebar {
        position: sticky;
        top: 18px;
        align-self: start;
        background: rgba(var(--tint-rgb), 0.22);
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 20px 40px rgba(26, 18, 11, 0.04);
        padding: 18px 14px 16px;
        backdrop-filter: blur(10px);
      }

      .brand-block {
        padding: 8px 8px 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--line);
      }

      .brand-en {
        font-size: 0.72rem;
        line-height: 1.7;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .brand-cn {
        margin-top: 8px;
        font-size: clamp(1.7rem, 2vw, 2.2rem);
        letter-spacing: 0.1em;
        font-weight: 700;
      }

      .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 12px 6px 14px;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .volume-tree {
        display: grid;
        gap: 10px;
      }

      .volume-panel {
        border: 1px solid transparent;
        border-radius: 14px;
        background: rgba(var(--tint-rgb), 0.14);
        overflow: hidden;
        transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
      }

      .volume-panel.is-open {
        border-color: var(--line-strong);
        background: rgba(var(--tint-rgb), 0.2);
      }

      .volume-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: none;
        background: transparent;
        color: var(--ink);
        padding: 12px 12px 10px;
        font: inherit;
        cursor: pointer;
        text-align: left;
      }

      .volume-name {
        font-size: 1.02rem;
        font-weight: 700;
      }

      .volume-count {
        min-width: 46px;
        text-align: center;
        border-radius: 999px;
        padding: 4px 8px;
        border: 1px solid var(--line);
        font-size: 0.72rem;
        color: var(--ink-soft);
        background: rgba(var(--tint-rgb), 0.12);
      }

      .volume-toggle::after {
        content: '+';
        font-size: 1.2rem;
        color: var(--ink-soft);
        transition: transform 0.2s ease;
      }

      .volume-panel.is-open .volume-toggle::after {
        content: '−';
        transform: rotate(180deg);
      }

      .chapter-list {
        display: none;
        gap: 7px;
        padding: 0 8px 10px;
      }

      .volume-panel.is-open .chapter-list {
        display: grid;
      }

      .chapter-item {
        display: grid;
        grid-template-columns: 74px 1fr;
        gap: 8px;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 8px 8px;
        background: rgba(var(--tint-rgb), 0.18);
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
      }

      .chapter-item:hover {
        transform: translateX(3px);
        border-color: var(--line-strong);
        background: rgba(var(--tint-rgb), 0.26);
      }

      .chapter-index {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        padding: 5px 4px;
        font-size: 0.7rem;
        letter-spacing: 0.05em;
        color: var(--ink-soft);
        background: var(--chip-bg);
      }

      .chapter-title {
        display: inline-flex;
        align-items: center;
        min-height: 32px;
        font-size: 0.8rem;
        line-height: 1.5;
      }

      .main-column {
        display: grid;
        grid-template-rows: auto 1fr;
        gap: 18px;
        min-width: 0;
        width: 100%;
        justify-self: start;
      }

      .intro-panel {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(var(--tint-rgb), 0.2);
        padding: 24px 28px 20px;
        box-shadow: 0 12px 30px rgba(45, 32, 20, 0.025);
      }

      .eyebrow {
        color: var(--ink-soft);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-size: 0.72rem;
        font-weight: 700;
      }

      h1 {
        margin: 10px 0 12px;
        font-size: clamp(2.6rem, 4.2vw, 4.3rem);
        letter-spacing: 0.06em;
        line-height: 1.08;
      }

      .subtitle {
        max-width: 780px;
        margin: 0;
        color: var(--ink-soft);
        font-size: 1.03rem;
        line-height: 1.9;
      }

      .hero-stage {
        position: relative;
        width: min(100%, 980px);
        min-height: 640px;
        aspect-ratio: 1 / 1;
        margin-left: clamp(20px, 2.6vw, 58px);
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--stage-bg);
        overflow: hidden;
        isolation: isolate;
        box-shadow: var(--stage-shadow);
      }

      .stage-glow {
        position: absolute;
        inset: 12% 18% 12% 18%;
        border-radius: 50%;
        border: 1px solid var(--line);
        z-index: 0;
        pointer-events: none;
        box-shadow: 0 0 0 26px var(--chip-bg), inset 0 0 0 10px var(--chip-bg);
      }

      .discussion-panel {
        width: min(100%, 980px);
        margin-left: clamp(20px, 2.6vw, 58px);
        padding: 22px 24px 20px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(var(--tint-rgb), 0.18);
        box-shadow: 0 12px 30px rgba(45, 32, 20, 0.025);
      }

      .discussion-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--line);
      }

      .discussion-header h3 {
        margin: 0;
        font-size: 1.12rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .discussion-badge {
        padding: 6px 10px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.18);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--ink-soft);
        text-transform: uppercase;
      }

      .discussion-form {
        display: grid;
        gap: 12px;
        margin-bottom: 18px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: rgba(var(--tint-rgb), 0.08);
      }

      .form-field {
        display: grid;
        gap: 8px;
        font-size: 0.72rem;
        color: var(--ink-soft);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .form-field input[readonly] {
        opacity: 0.75;
        cursor: default;
      }

      .discussion-identity {
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: none;
        color: var(--ink-soft);
      }

      .verified-badge {
        margin-left: 6px;
        padding: 2px 8px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(var(--tint-rgb), 0.18);
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        color: var(--ink-soft);
        text-transform: uppercase;
      }

      .form-field input,
      .form-field textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--field-bg);
        color: var(--ink);
        font: inherit;
        font-size: 1rem;
        letter-spacing: normal;
        text-transform: none;
        resize: vertical;
      }

      .discussion-form-actions {
        display: flex;
        justify-content: flex-end;
      }

      .discussion-form button,
      .modal-submit {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--btn-bg);
        color: var(--ink);
        padding: 10px 18px;
        cursor: pointer;
        font: inherit;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .discussion-status {
        min-height: 1.4em;
        margin-bottom: 16px;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .discussion-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .discussion-item {
        padding: 16px 16px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: rgba(var(--tint-rgb), 0.12);
      }

      .discussion-topic {
        margin: 0 0 12px;
        font-size: 1rem;
        letter-spacing: 0.04em;
      }

      .discussion-meta {
        margin: 0 0 10px;
        font-size: 0.72rem;
        color: var(--ink-soft);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .discussion-item p {
        margin: 0;
        line-height: 1.8;
        color: var(--ink-soft);
      }

      .auth-modal {
        position: fixed;
        inset: 0;
        background: var(--scrim);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        z-index: 1000;
      }

      .auth-modal.is-open {
        display: flex;
      }

      .auth-modal-card {
        width: min(420px, 100%);
        max-height: calc(100vh - 32px);
        max-height: calc(100dvh - 32px);
        overflow-y: auto;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--card-bg);
        box-shadow: 0 20px 60px rgba(30, 20, 14, 0.12);
        padding: 22px 20px;
      }

      .auth-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }

      .auth-header h3 {
        margin: 0;
        font-size: 1.1rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .auth-close {
        border: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        border-radius: 999px;
        width: 32px;
        height: 32px;
        cursor: pointer;
      }

      .auth-form {
        display: grid;
        gap: 12px;
      }

      .auth-form label {
        display: grid;
        gap: 8px;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .auth-form input {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--input-bg);
        color: var(--ink);
        font: inherit;
        font-size: 1rem;
        letter-spacing: normal;
        text-transform: none;
        padding: 12px 14px;
      }

      .auth-mode-toggle {
        display: flex;
        gap: 8px;
        margin-bottom: 10px;
      }

      .auth-mode-toggle button {
        flex: 1;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        padding: 9px 10px;
        cursor: pointer;
        color: var(--ink);
        font: inherit;
      }

      .auth-mode-toggle button.is-active {
        background: var(--active-bg);
      }

      .auth-message {
        min-height: 1.4em;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 8px;
      }

      .modal-cancel {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        padding: 10px 16px;
        cursor: pointer;
      }

      .tesseract-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 1;
        background: transparent;
      }

      .story-panel {
        position: absolute;
        right: clamp(26px, 4vw, 56px);
        bottom: clamp(26px, 4vw, 50px);
        width: min(320px, 42vw);
        padding: 18px 18px 16px;
        border: 1px solid var(--line-strong);
        border-radius: 18px;
        background: var(--story-bg);
        backdrop-filter: blur(8px);
        box-shadow: 0 18px 28px rgba(44, 32, 22, 0.08);
        z-index: 3;
      }

      .story-panel .label {
        display: inline-block;
        margin-bottom: 10px;
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .story-panel h2 {
        margin: 0 0 10px;
        font-size: clamp(1.4rem, 2vw, 2rem);
        letter-spacing: 0.06em;
      }

      .story-panel p {
        margin: 0 0 16px;
        color: var(--ink-soft);
        line-height: 1.7;
      }

      .story-panel a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 999px;
        border: 1px solid var(--line-strong);
        background: var(--btn-bg);
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      @media (max-width: 1100px) {
        .app-shell {
          grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
          gap: 22px;
        }

        .hero-stage,
        .discussion-panel {
          margin-left: 0;
        }

        .hero-stage {
          min-height: 520px;
        }
      }

      @media (max-width: 1024px) {
        .chapter-item,
        .volume-toggle,
        .auth-button,
        .theme-toggle {
          min-height: 44px;
        }

        .volume-toggle {
          padding-top: 10px;
          padding-bottom: 10px;
        }
      }

      @media (max-width: 900px) {
        .app-shell {
          grid-template-columns: 1fr;
          padding-top: 20px;
        }

        .sidebar {
          position: static;
          max-height: 52vh;
          overflow-y: auto;
        }

        .main-column {
          width: 100%;
        }

        .hero-stage,
        .discussion-panel {
          margin-left: 0;
          width: 100%;
        }

        .hero-stage {
          min-height: 420px;
        }

        .story-panel {
          width: min(320px, calc(100% - 24px));
          right: 12px;
          bottom: 12px;
        }
      }

      @media (max-width: 640px) {
        .app-shell {
          padding-left: max(14px, env(safe-area-inset-left));
          padding-right: max(14px, env(safe-area-inset-right));
          padding-bottom: max(46px, env(safe-area-inset-bottom));
          gap: 18px;
        }

        .sidebar,
        .intro-panel,
        .hero-stage,
        .discussion-panel {
          border-radius: 16px;
        }

        .sidebar {
          padding: 14px 12px;
        }

        .brand-cn {
          font-size: 1.45rem;
          letter-spacing: 0.06em;
        }

        .volume-tree {
          gap: 8px;
        }

        .volume-panel.is-open .chapter-list {
          max-height: 46vh;
          overflow-y: auto;
        }

        .intro-panel {
          padding: 20px 18px 18px;
        }

        h1 {
          font-size: clamp(2.1rem, 9vw, 3rem);
          letter-spacing: 0.04em;
        }

        .subtitle {
          font-size: 0.96rem;
        }

        .hero-stage {
          min-height: 0;
          height: min(88vw, 420px);
          aspect-ratio: auto;
          margin-left: 0;
          border-radius: 26px;
          overflow: hidden;
        }

        .stage-glow {
          inset: 6% 16%;
        }

        .story-panel {
          left: 12px;
          right: 12px;
          bottom: 12px;
          width: auto;
          padding: 14px 14px 12px;
          z-index: 3;
        }

        .discussion-panel {
          padding: 18px 16px 16px;
        }

        .discussion-form button,
        .modal-submit,
        .modal-cancel {
          min-height: 44px;
        }

        .auth-close {
          width: 44px;
          height: 44px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 1.1rem;
          line-height: 1;
        }

        .discussion-header {
          flex-direction: column;
          align-items: flex-start;
        }

        .discussion-list {
          grid-template-columns: 1fr;
        }

        .chapter-item {
          grid-template-columns: 1fr;
        }

        .chapter-index {
          justify-self: start;
        }
      }

      @media (max-width: 420px) {
        .topbar {
          height: 56px;
        }

        .topbar-inner {
          padding-left: max(14px, env(safe-area-inset-left));
          padding-right: max(14px, env(safe-area-inset-right));
        }

        .auth-button,
        .theme-toggle {
          padding: 10px 12px;
          font-size: 0.78rem;
        }

        .story-panel {
          padding: 12px 12px 10px;
          border-radius: 14px;
        }
      }

      /* 主页本体的三处 hover/展开过渡不在动效层的 reduce 块里，就地补上 */
      @media (prefers-reduced-motion: reduce) {
        .volume-panel,
        .volume-toggle::after,
        .chapter-item {
          transition: none;
        }

        .chapter-item:hover {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar" aria-label="顶部导航">
      <div class="topbar-inner">
        <button class="theme-toggle" id="themeToggle" type="button" data-theme-toggle aria-pressed="false">深色</button>
        <span class="account-chip auth-button" id="accountChip" hidden></span>
        <button class="auth-button" id="openAuthButton" type="button">登录 / 注册</button>
        <button class="auth-button" id="logoutButton" type="button" hidden>退出</button>
      </div>
    </header>

    <div class="auth-modal" id="authModal" aria-hidden="true">
      <div class="auth-modal-card" role="dialog" aria-modal="true" aria-labelledby="authTitle">
        <div class="auth-header">
          <h3 id="authTitle">账户入口</h3>
          <button class="auth-close" id="closeAuthButton" type="button" aria-label="关闭">×</button>
        </div>

        <div class="auth-mode-toggle">
          <button class="is-active" type="button" data-mode="login">登录</button>
          <button type="button" data-mode="register">注册</button>
        </div>

        <form class="auth-form" id="authForm">
          <label>
            <span>用户名</span>
            <input id="authUsername" name="username" type="text" autocomplete="username" maxlength="24" placeholder="你的用户名" required />
          </label>

          <label>
            <span>密码</span>
            <input id="authPassword" name="password" type="password" autocomplete="current-password" maxlength="128" placeholder="输入密码" required />
          </label>

          <label id="registerDisplayField" class="field-hidden">
            <span>昵称（可选）</span>
            <input id="authDisplayName" name="displayName" type="text" maxlength="24" placeholder="可选昵称" />
          </label>

          <label class="auth-remember">
            <input id="authRemember" name="remember" type="checkbox" />
            <span>记住我（30 天内免登录）</span>
          </label>

          <div class="auth-message" id="authMessage" aria-live="polite"></div>

          <div class="modal-actions">
            <button class="modal-cancel" id="cancelAuthButton" type="button">取消</button>
            <button class="modal-submit" id="authSubmitButton" type="submit">登录</button>
          </div>
        </form>
      </div>
    </div>

    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand-block">
          <div class="brand-en">Chandelier In the Midnight with an Idoit and a Cup</div>
          <div class="brand-cn">《吊灯》</div>
        </div>

        <RadioPlayer musicFiles={musicFiles} />

        <div class="sidebar-header">
          <span>卷目目录</span>
          <span>{chaptersByPart.length} 卷</span>
        </div>

        <div class="volume-tree">
          {chaptersByPart.map(({ part, chapters }) => (
            <div class={`volume-panel ${part === '第一卷' ? 'is-open' : ''}`}>
              <button class="volume-toggle" type="button" aria-expanded={part === '第一卷' ? 'true' : 'false'}>
                <span class="volume-name">{part}</span>
                <span class="volume-count">{chapters.length}</span>
              </button>

              <div class="chapter-list">
                {chapters.map((chapter) => (
                  <a class="chapter-item" href={`/Novels/${chapter.id.replace(/\.md$/, '')}`}>
                    <span class="chapter-index">第{chapter.data.chapter}章</span>
                    <span class="chapter-title">{chapter.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </aside>

      <main class="main-column">
        <section class="intro-panel">
          <div class="eyebrow">Novel archive · midnight edition</div>
          <h1>《吊灯》</h1>
          <p class="subtitle">
            一杯热茶与一盏吊灯的故事。 不，这里没有蠢货。<br>这里<strong>自15年前</strong>就没住过人。
          </p>
        </section>

        <section class="hero-stage" aria-label="首页动画展示区">
          <div class="stage-glow"></div>
          <canvas class="tesseract-canvas" id="tesseractCanvas" aria-label="超立方体线框动画"></canvas>

          <div class="story-panel">
            <span class="label">当前卷目</span>
            {featuredChapter ? (
              <>
                <h2>{featuredChapter.data.part}</h2>
                <p>第{featuredChapter.data.chapter}章 · {featuredChapter.data.title}</p>
                <a href={`/Novels/${featuredChapter.id.replace(/\.md$/, '')}`}>进入正文</a>
              </>
            ) : (
              <>
                <h2>暂无章节</h2>
                <p>故事目录尚未整理完，先静候灯火再续篇章。</p>
              </>
            )}
          </div>
        </section>

        <section class="discussion-panel" aria-label="公共讨论区">
          <div class="discussion-header">
            <h3>公共讨论区</h3>
            <span class="discussion-badge">站内公开</span>
          </div>

          <form class="discussion-form" id="discussionForm">
            <label class="form-field">
              <span>昵称</span>
              <input id="discussionName" name="name" type="text" maxlength="24" placeholder="匿名读者" required />
              <span class="discussion-identity" id="discussionIdentity">未登录，将以匿名读者身份发布。</span>
            </label>

            <label class="form-field">
              <span>留言</span>
              <textarea id="discussionMessage" name="message" rows="3" maxlength="220" placeholder="写下你对这座灯影与故事的想法…" required></textarea>
            </label>

            <div class="discussion-form-actions">
              <button type="submit">发表留言</button>
            </div>
          </form>

          <div class="discussion-status" id="discussionStatus" aria-live="polite"></div>
          <div class="discussion-list" id="discussionList"></div>
        </section>
      </main>
    </div>

    <script>
      import { escapeHtml, formatCommentTime, normalizePlainText } from '../utils/sanitize';
      import { initTheme, toggleTheme } from '../utils/theme';
      import { mountTesseract } from '../utils/tesseract';
      // 管理员删除层：走这个脚本一起打进 /_astro 的外部模块。写成 <script src="…">
      // 会被 Astro 内联成 <script> 内容，然后被 CSP 的 script-src 'self' 挡掉。
      import '../scripts/discussion-moderation.js';

      initTheme();
      document.getElementById('themeToggle')?.addEventListener('click', () => toggleTheme());

      const volumePanels = document.querySelectorAll('.volume-panel');

      volumePanels.forEach((panel) => {
        const toggle = panel.querySelector('.volume-toggle');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const shouldOpen = !panel.classList.contains('is-open');

          volumePanels.forEach((item) => {
            item.classList.remove('is-open');
            const button = item.querySelector('.volume-toggle');
            if (button) button.setAttribute('aria-expanded', 'false');
          });

          if (shouldOpen) {
            panel.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        });
      });

      const authOpenButton = document.getElementById('openAuthButton');
      const authModal = document.getElementById('authModal');
      const closeAuthButton = document.getElementById('closeAuthButton');
      const cancelAuthButton = document.getElementById('cancelAuthButton');
      const authForm = document.getElementById('authForm');
      const authUsername = document.getElementById('authUsername');
      const authPassword = document.getElementById('authPassword');
      const authDisplayName = document.getElementById('authDisplayName');
      const authMessage = document.getElementById('authMessage');
      const registerDisplayField = document.getElementById('registerDisplayField');
      const authModeButtons = document.querySelectorAll('[data-mode]');
      const authSubmitButton = document.getElementById('authSubmitButton');
      const authRemember = document.getElementById('authRemember');
      const accountChip = document.getElementById('accountChip');
      const logoutButton = document.getElementById('logoutButton');
      let authMode = 'login';
      let currentUser = null;
      let authPending = false;
      let lastFocused = null;

      function syncAuthMode() {
        if (!authModeButtons.length || !registerDisplayField || !authSubmitButton) return;

        authModeButtons.forEach((button) => {
          const active = button.dataset.mode === authMode;
          button.classList.toggle('is-active', active);
        });

        const isRegister = authMode === 'register';
        registerDisplayField.classList.toggle('field-hidden', !isRegister);
        authSubmitButton.textContent = isRegister ? '注册' : '登录';
        if (authPassword) authPassword.setAttribute('autocomplete', isRegister ? 'new-password' : 'current-password');
      }

      function focusablesIn(container) {
        return Array.from(container.querySelectorAll('button, input, select, textarea, a[href]')).filter(
          (item) => !item.hasAttribute('hidden') && item.getAttribute('aria-hidden') !== 'true' && !item.disabled,
        );
      }

      function openAuthModal() {
        if (!authModal) return;
        lastFocused = document.activeElement;
        authModal.classList.add('is-open');
        authModal.setAttribute('aria-hidden', 'false');
        (authMode === 'register' ? authDisplayName : authUsername)?.focus();
      }

      function closeAuthModal() {
        if (!authModal) return;
        // Leaving focus inside an aria-hidden dialog hides it from screen readers.
        const fallback = lastFocused instanceof HTMLElement ? lastFocused : authOpenButton;
        if (authModal.contains(document.activeElement)) fallback?.focus();
        authModal.classList.remove('is-open');
        authModal.setAttribute('aria-hidden', 'true');
      }

      authOpenButton?.addEventListener('click', openAuthModal);
      closeAuthButton?.addEventListener('click', closeAuthModal);
      cancelAuthButton?.addEventListener('click', closeAuthModal);
      authModal?.addEventListener('click', (event) => {
        if (event.target === authModal) closeAuthModal();
      });

      document.addEventListener('keydown', (event) => {
        if (!authModal || !authModal.classList.contains('is-open')) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          closeAuthModal();
          return;
        }

        // Tab stays inside the dialog so background controls are unreachable.
        if (event.key !== 'Tab') return;
        const items = focusablesIn(authModal);
        if (items.length === 0) return;

        const first = items[0];
        const last = items[items.length - 1];
        const active = document.activeElement;

        if (event.shiftKey && (!authModal.contains(active) || active === first)) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      });

      authModeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          authMode = button.dataset.mode === 'register' ? 'register' : 'login';
          syncAuthMode();
          if (authMessage) authMessage.textContent = '';
        });
      });

      syncAuthMode();

      async function submitAuth(event) {
        event.preventDefault();
        if (!authForm || !authUsername || !authPassword) return;
        // A second click while the first request is in flight would burn a
        // login attempt from the rate-limit budget and race two cookies.
        if (authPending) return;

        const username = authUsername.value.trim();
        const password = authPassword.value;

        if (!username || !password) {
          if (authMessage) authMessage.textContent = '用户名和密码不能为空。';
          return;
        }

        const isRegister = authMode === 'register';
        const payload = {
          action: authMode,
          username,
          password,
          remember: authRemember ? authRemember.checked : false,
          ...(isRegister && authDisplayName ? { displayName: authDisplayName.value.trim() } : {}),
        };

        authPending = true;
        if (authSubmitButton) {
          authSubmitButton.disabled = true;
          authSubmitButton.textContent = isRegister ? '注册中…' : '登录中…';
        }

        try {
          const response = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await response.json().catch(() => ({}));

          if (!response.ok) {
            const retryAfter = Number(response.headers.get('Retry-After') || 0);
            const suffix = response.status === 429 && retryAfter > 0 ? `（约 ${Math.ceil(retryAfter / 60)} 分钟后可再试）` : '';
            if (authMessage) authMessage.textContent = `${data.error || '认证失败。'}${suffix}`;
            return;
          }

          if (data.warning && authMessage) {
            authMessage.textContent = data.warning;
          } else if (authMessage) {
            authMessage.textContent = isRegister ? '注册成功，已自动登录。' : `欢迎回来，${data.user?.displayName || data.user?.username || '读者'}。`;
          }

          authForm.reset();
          renderSession(data.user || null);
          closeAuthModal();
          syncDiscussionIdentity();
        } catch {
          if (authMessage) authMessage.textContent = '当前无法连接到认证服务，请稍后再试。';
        } finally {
          authPending = false;
          if (authSubmitButton) {
            authSubmitButton.disabled = false;
            authSubmitButton.textContent = isRegister ? '注册' : '登录';
          }
        }
      }

      authForm?.addEventListener('submit', submitAuth);

      function renderSession(user) {
        currentUser = user || null;
        const signedIn = Boolean(currentUser);

        if (accountChip) {
          accountChip.hidden = !signedIn;
          const label = signedIn ? currentUser.displayName || currentUser.username : '';
          accountChip.textContent = signedIn && currentUser.role === 'admin' ? `${label} · 管理员` : label;
        }
        if (authOpenButton) authOpenButton.hidden = signedIn;
        if (logoutButton) logoutButton.hidden = !signedIn;
      }

      async function refreshSession() {
        try {
          const response = await fetch('/api/auth', { cache: 'no-store' });
          if (!response.ok) return;
          const data = await response.json().catch(() => ({}));
          renderSession(data.user || null);
          syncDiscussionIdentity();
        } catch {
          // Auth service unreachable: keep the anonymous controls.
        }
      }

      // Server-side revocation only helps if the user can actually pull the trigger.
      logoutButton?.addEventListener('click', async () => {
        logoutButton.disabled = true;
        try {
          await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'logout' }),
          });
        } finally {
          renderSession(null);
          syncDiscussionIdentity();
          logoutButton.disabled = false;
          if (authMessage) authMessage.textContent = '';
          authOpenButton?.focus();
        }
      });

      refreshSession();

      // The server signs the author from the session and ignores the posted
      // name, so the form must not imply the nickname field still decides it.
      function syncDiscussionIdentity() {
        const nameInput = document.getElementById('discussionName');
        const hint = document.getElementById('discussionIdentity');
        if (!nameInput) return;

        if (currentUser) {
          nameInput.value = currentUser.displayName || currentUser.username || '';
          nameInput.readOnly = true;
          if (hint) hint.textContent = `将以「${nameInput.value}」的身份发布（已验证）`;
        } else {
          nameInput.readOnly = false;
          if (hint) hint.textContent = '未登录，将以匿名读者身份发布。';
        }
      }

      const discussionForm = document.getElementById('discussionForm');
      const discussionName = document.getElementById('discussionName');
      const discussionMessage = document.getElementById('discussionMessage');
      const discussionList = document.getElementById('discussionList');
      const discussionStatus = document.getElementById('discussionStatus');
      const discussionStorageKey = 'chandelier-public-discussion-v1';

      const discussionSeed = [
        {
          id: 'seed-1',
          name: '站内公开',
          message: '这里是公开留言区，欢迎留下对灯影与卷章的看法。',
          createdAt: new Date().toISOString(),
        },
        {
          id: 'seed-2',
          name: '读者',
          message: '四周的光线像灯芯在纸页上慢慢起伏，故事也顺着这股温度往前走。',
          createdAt: new Date(Date.now() - 3600000).toISOString(),
        }
      ];

      function cleanComment(item) {
        if (!item || typeof item !== 'object') return null;

        const message = normalizePlainText(item.message, 220);
        if (!message) return null;

        return {
          id: normalizePlainText(item.id, 64, ''),
          name: normalizePlainText(item.name, 24, '匿名读者'),
          message,
          createdAt: typeof item.createdAt === 'string' ? item.createdAt : '',
          verified: item.verified === true,
        };
      }

      function cleanCommentList(items) {
        if (!Array.isArray(items)) return [];
        return items.map(cleanComment).filter(Boolean);
      }

      function readLocalDiscussion() {
        try {
          const raw = localStorage.getItem(discussionStorageKey);
          if (!raw) return discussionSeed;
          const parsed = cleanCommentList(JSON.parse(raw));
          return parsed.length > 0 ? parsed : discussionSeed;
        } catch {
          return discussionSeed;
        }
      }

      function writeLocalDiscussion(items) {
        try {
          localStorage.setItem(discussionStorageKey, JSON.stringify(cleanCommentList(items)));
        } catch {
          // ignore storage errors on restricted browsers
        }
      }

      function renderDiscussion(items) {
        if (!discussionList) return;

        const comments = cleanCommentList(items);
        const list = comments.length > 0 ? comments : discussionSeed;

        // Escaping happens here, immediately before the value reaches HTML.
        discussionList.innerHTML = list
          .slice(0, 9)
          .map((item) => {
            const time = escapeHtml(formatCommentTime(item.createdAt));
            const name = escapeHtml(item.name || '匿名读者');
            const badge = item.verified ? '<span class="verified-badge">已验证</span>' : '';
            const topic = escapeHtml(Array.from(item.message || '').slice(0, 80).join(''));
            const body = escapeHtml(Array.from(item.message || '').slice(0, 180).join(''));

            return `
              <article class="discussion-item" data-id="${escapeHtml(item.id)}">
                <p class="discussion-meta">${time} · ${name}${badge}</p>
                <h4 class="discussion-topic">${topic}</h4>
                <p>${body}</p>
              </article>
            `;
          })
          .join('');
      }

      async function loadDiscussion() {
        if (!discussionList) return;

        try {
          // 服务端给列表发了 public, max-age=20；这里若再带 cache: 'no-store'，
          // Cloudflare 会当客户端明确拒收缓存而绕过边缘缓存，每次浏览都打一次 Worker。
          const response = await fetch('/api/discussions');
          if (response.ok) {
            const payload = await response.json();
            if (Array.isArray(payload.comments) && payload.comments.length > 0) {
              renderDiscussion(payload.comments);
              writeLocalDiscussion(payload.comments);
              return;
            }
          }
        } catch {
          // fallback silently to local storage when the API is unavailable
        }

        renderDiscussion(readLocalDiscussion());
      }

      async function submitDiscussion(event) {
        event.preventDefault();
        if (!discussionForm || !discussionName || !discussionMessage || !discussionStatus) return;

        const comment = cleanComment({
          id: `${Date.now()}`,
          name: discussionName.value,
          message: discussionMessage.value,
          createdAt: new Date().toISOString(),
        });

        if (!comment) {
          discussionStatus.textContent = '留言内容不能为空。';
          return;
        }

        discussionStatus.textContent = '正在提交…';

        try {
          const response = await fetch('/api/discussions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: comment.name, message: comment.message }),
          });

          const data = await response.json().catch(() => ({}));
          const serverComments = cleanCommentList(data.comments);

          if (response.ok && serverComments.length > 0) {
            writeLocalDiscussion(serverComments);
            renderDiscussion(serverComments);
            discussionStatus.textContent = data.warning ? '已提交，当前为本地回退模式。' : '留言已发布。';
          } else if (response.status === 429) {
            // A throttle is not a storage failure: do not pretend the message
            // was kept locally when the server simply refused the rate.
            discussionStatus.textContent = data.error || '发言过于频繁，请稍后再试。';
            return;
          } else {
            const localItems = [comment, ...readLocalDiscussion()].slice(0, 12);
            writeLocalDiscussion(localItems);
            renderDiscussion(localItems);
            discussionStatus.textContent = data.error || '提交失败，已保存在本地回退区。';
          }
        } catch {
          const localItems = [comment, ...readLocalDiscussion()].slice(0, 12);
          writeLocalDiscussion(localItems);
          renderDiscussion(localItems);
          discussionStatus.textContent = '留言已保存到本地，页面刷新后仍可看到。';
        }

        discussionForm.reset();
        // reset() also blanks the session-filled nickname; put it back.
        syncDiscussionIdentity();
      }

      if (discussionForm) {
        discussionForm.addEventListener('submit', submitDiscussion);
      }

      loadDiscussion();

      mountTesseract(document.getElementById('tesseractCanvas'));

    </script>
  </body>
</html>
